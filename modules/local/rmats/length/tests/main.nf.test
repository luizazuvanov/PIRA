nextflow_process {

    name "Test Process RMATS_LENGTH"
    script "../main.nf"
    process "RMATS_LENGTH"

    test("success") {

        when {
            process {
                """
                input[0] = Channel.of([ id: 'condition', alignment: 'alignment' ])
                input[1] = Channel.of([
                    file('${projectDir}/assets/test/minimal.one.stats', checkIfExists: true),
                    file('${projectDir}/assets/test/minimal.two.stats', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }
}
