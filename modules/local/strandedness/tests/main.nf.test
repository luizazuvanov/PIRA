nextflow_process {

    name "Test Process STRANDEDNESS"
    script "../main.nf"
    process "STRANDEDNESS"

    test("should successfully run strandedness") {
        setup {
            run("RSEQC_INFEREXPERIMENT") {
                script "../../../nf-core/rseqc/inferexperiment"
                process {
                    """
                    input[0] = Channel.of([
                        [ id: 'experiment', alignment: 'alignment', condition: 'condition' ],
                        file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam", checkIfExists: true),
                    ])
                    input[1] = Channel.of(file(params.modules_testdata_base_path + "genomics/sarscov2/genome/bed/test.bed", checkIfExists: true))
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = RSEQC_INFEREXPERIMENT.out.txt
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
