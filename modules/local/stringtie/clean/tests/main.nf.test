nextflow_process {

    name "Test Process STRINGTIE_CLEAN"
    script "modules/local/stringtie/clean/main.nf"
    process "STRINGTIE_CLEAN"

    test("sarscov2 - gtf") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id: 'gtf' ],
                    [ file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.gtf', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
