{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/pira/master/assets/schema_input.json",
    "title": "nf-core/pira pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "run": {
                "type": "string",
                "errorMessage": "NCBI Run accession ID (e.g. SRR16496056)",
                "meta": ["id"]
            },
            "experiment": {
                "type": "string",
                "pattern": "[a-zA-Z0-9]",
                "errorMessage": "NCBI Experiment accession ID (e.g. SRX12699021)"
            },
            "condition": {
                "type": "string",
                "pattern": "[a-zA-Z0-9]",
                "errorMessage": "Custom condition name to group replicates together"
            },
            "fastq_1": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.f(ast)?q\\.gz$",
                "errorMessage": "File path to the first FASTQ file for this sample"
            },
            "fastq_2": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.f(ast)?q\\.gz$",
                "errorMessage": "File path to the second FASTQ file for this sample (if paired-end)"
            },
            "fastp_1": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.f(ast)?q\\.gz$",
                "errorMessage": "File path to the first FASTP processed FASTQ file for this sample"
            },
            "fastp_2": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.f(ast)?q\\.gz$",
                "errorMessage": "File path to the second FASTP processed FASTQ file for this sample (if paired-end)"
            }
        },
        "required": ["run", "experiment", "condition"]
    }
}
