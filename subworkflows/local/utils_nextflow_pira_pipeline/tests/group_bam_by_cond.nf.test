nextflow_workflow {

    name "Test Workflow group_bam_by_cond"
    script "subworkflows/local/utils_nextflow_pira_pipeline/tests/group_bam_by_cond.nf"
    workflow "TEST_GROUP_BAM_BY_COND"

    test("group_bam_by_cond") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    [ condition: 'cond-1', bam: 'bam-1' ],
                    [ condition: 'cond-1', bam: 'bam-2' ],
                    [ condition: 'cond-2', bam: 'bam-3' ],
                    [ condition: 'cond-2', bam: 'bam-4' ]
                )
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
