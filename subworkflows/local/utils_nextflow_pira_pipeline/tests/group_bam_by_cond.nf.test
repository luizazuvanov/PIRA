nextflow_function {

    name "Test Function group_bam_by_cond"
    script "../main.nf"
    function "group_bam_by_cond"

    test("group_bam_by_cond") {

        when {
            function {
                """
                input[0] = Channel.of(
                    [ condition: 'cond-1', bam: 'bam-1' ],
                    [ condition: 'cond-1', bam: 'bam-2' ],
                    [ condition: 'cond-2', bam: 'bam-3' ],
                    [ condition: 'cond-2', bam: 'bam-4' ]
                )
                """
            }
        }

        then {
            assert function.success
        }

    }

}
