nextflow_workflow {

    name "Test Workflow group_stats"
    script "../main.nf"
    workflow "group_stats"

    test("group_stats") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    [ stats: 'stats-1' ],
                    [ stats: 'stats-2' ],
                    [ stats: 'stats-3' ],
                    [ stats: 'stats-4' ],
                    [ stats: 'stats-5' ],
                    [ stats: 'stats-6' ]
                )
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
