nextflow_function {

    name "Test Function group_fastp_by_exp_cond_end"
    script "../main.nf"
    function "group_fastp_by_exp_cond_end"

    test("group_fastp_by_exp_cond_end - single end true") {

        when {
            function {
                """
                input[0] = Channel.of(
                    [ experiment: 'exp-1', condition: 'cond-1', single_end: true, fastp: 'fastp-1' ],
                    [ experiment: 'exp-1', condition: 'cond-1', single_end: true, fastp: 'fastp-2' ],
                    [ experiment: 'exp-2', condition: 'cond-2', single_end: true, fastp: 'fastp-3' ],
                    [ experiment: 'exp-2', condition: 'cond-2', single_end: true, fastp: 'fastp-4' ]
                )
                """
            }
        }

        then {
            assert function.success
        }

    }

    test("group_fastp_by_exp_cond_end - single end false") {

        when {
            function {
                """
                input[0] = Channel.of(
                    [ experiment: 'exp-1', condition: 'cond-1', single_end: false, fastp: ['fastp-1-1', 'fastp-2-1'] ],
                    [ experiment: 'exp-1', condition: 'cond-1', single_end: false, fastp: ['fastp-1-2', 'fastp-2-2'] ],
                    [ experiment: 'exp-2', condition: 'cond-2', single_end: false, fastp: ['fastp-1-3', 'fastp-2-3'] ],
                    [ experiment: 'exp-2', condition: 'cond-2', single_end: false, fastp: ['fastp-1-4', 'fastp-2-4'] ]
                )
                """
            }
        }

        then {
            assert function.success
        }

    }

}
