nextflow_function {

    name "Test Function group_spl_by_alignment"
    script "../main.nf"
    function "group_spl_by_alignment"

    test("group_spl_by_alignment") {

        when {
            function {
                """
                input[0] = Channel.of(
                    [ alignment: 'align-1', spl: 'spl-1' ],
                    [ alignment: 'align-1', spl: 'spl-2' ],
                    [ alignment: 'align-2', spl: 'spl-3' ],
                    [ alignment: 'align-2', spl: 'spl-4' ]
                )
                """
            }
        }

        then {
            assert function.success
        }

    }

}
