nextflow_workflow {

    name "Test Workflow group_bam_by_cond_keep_align"
    script "../main.nf"
    workflow "group_bam_by_cond_keep_align"

    test("group_bam_by_cond_keep_align") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    [ condition: 'cond-1', alignment: 'align', bam: 'bam-1' ],
                    [ condition: 'cond-1', alignment: 'align', bam: 'bam-2' ],
                    [ condition: 'cond-2', alignment: 'align', bam: 'bam-3' ],
                    [ condition: 'cond-2', alignment: 'align', bam: 'bam-4' ]
                )
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
