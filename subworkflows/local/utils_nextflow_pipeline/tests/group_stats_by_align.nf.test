nextflow_workflow {

    name "Test Workflow group_stats_by_align"
    script "../main.nf"
    workflow "group_stats_by_align"

    test("group_stats_by_align") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    [ alignment: 'align-1', stats: 'stats-1' ],
                    [ alignment: 'align-1', stats: 'stats-2' ],
                    [ alignment: 'align-1', stats: 'stats-3' ],
                    [ alignment: 'align-2', stats: 'stats-4' ],
                    [ alignment: 'align-2', stats: 'stats-5' ],
                    [ alignment: 'align-2', stats: 'stats-6' ],
                )
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
