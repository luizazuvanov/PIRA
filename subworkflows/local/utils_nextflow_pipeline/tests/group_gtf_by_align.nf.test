nextflow_workflow {

    name "Test Workflow group_gtf_by_align"
    script "../main.nf"
    workflow "group_gtf_by_align"

    test("group_gtf_by_align") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    [ alignment: 'align-1', gtf: 'gtf-1' ],
                    [ alignment: 'align-1', gtf: 'gtf-2' ],
                    [ alignment: 'align-1', gtf: 'gtf-3' ],
                    [ alignment: 'align-2', gtf: 'gtf-4' ],
                    [ alignment: 'align-2', gtf: 'gtf-5' ],
                    [ alignment: 'align-2', gtf: 'gtf-6' ]
                )
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
